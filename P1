// Check whether the move is valid
bool isValid(int row, int col) {
    return row >= 0 && row < 3 && col >= 0 && col < 3;
}

// Convert puzzle into a string for storing in visited set
string toString(vector<vector<int>>& puzzle) {
    string s = "";
    for (int i = 0; i < 3; i++)
        for (int j = 0; j < 3; j++)
            s += char(puzzle[i][j] + '0');
    return s;
}

